# ---- Base de datos ----
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbudget

# ---- Seguridad ----
# Duración de la sesión en horas (más corta = más seguro).
SESION_HORAS=2
# Clave que cifra el secreto de Google Authenticator en la base. La crea preparar_base.py sola; no la pierdas.
TOTP_CLAVE=
# Intentos fallidos de login permitidos por correo y ventana en segundos (15 min).
LOGIN_MAX_FALLOS=5
LOGIN_VENTANA_SEG=900

# ---- Frontend (CORS y enlaces del correo) ----
# Direcciones desde donde se abre el frontend, separadas por coma. En AWS pon aquí tu dominio https://...
CORS_ORIGENES=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
FRONTEND_URL=http://127.0.0.1:5500

# ---- Correo para "olvidé mi contraseña" (opcional) ----
# Si SMTP_HOST queda vacío, el enlace se imprime en la terminal del backend (útil para la demostración).
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
