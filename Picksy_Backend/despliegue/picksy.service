# /etc/systemd/system/picksy.service
# Mantiene el backend encendido en el servidor y lo reinicia si se cae o si se reinicia la máquina.
[Unit]
Description=Picksy API (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/picksy/backend
EnvironmentFile=/home/ubuntu/picksy/backend/.env
# IMPORTANTE: un solo proceso (--workers 1). El límite de intentos de login vive en la memoria del proceso;
# con varios workers cada uno llevaría su propia cuenta.
ExecStart=/home/ubuntu/picksy/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
