# /etc/systemd/system/picksy-2.service
# SEGUNDA instancia de la API (puerto 8001). OPCIONAL: solo se usa junto con Redis (REDIS_URL en el .env) y con
# el balanceo de Nginx (despliegue/nginx-2-instancias.conf.ejemplo). Si una instancia se cae o se reinicia, la otra sigue
# atendiendo. Es igual a picksy.service; solo cambian la descripción y el puerto.
# Pasos completos y cómo volver atrás: MANUAL_OPERACION.md, sección "Alta disponibilidad básica".
[Unit]
Description=Picksy API (FastAPI) - instancia 2
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/picksy/backend
EnvironmentFile=/home/ubuntu/picksy/backend/.env
# Un solo proceso por servicio. El límite de intentos se comparte entre las 2 instancias gracias a Redis.
ExecStart=/home/ubuntu/picksy/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
